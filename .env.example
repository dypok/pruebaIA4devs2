# ==============================================================================
# SISMOWATCH - CONFIGURACIÓN DE VARIABLES DE ENTORNO (.env.example)
# Copiar este archivo a .env antes de levantar con: docker compose up -d
# NUNCA subir el archivo .env real al repositorio de control de versiones.
# ==============================================================================

# --- Apache Airflow ---
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=./airflow
AIRFLOW__CORE__FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLbficBpPo=
AIRFLOW__WEBSERVER__SECRET_KEY=sismowatch_webserver_secret_session_key_2026
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin_sismowatch_airflow_2026!
AIRFLOW_ADMIN_EMAIL=dataeng@sismowatch.superapp.internal
AIRFLOW_PORT=8085

# --- MinIO Object Storage (S3 Data Lakehouse) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin2026!
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET_NAME=sismowatch-lake
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin2026!
AWS_REGION=us-east-1
S3_ENDPOINT_URL=http://minio:9000

# --- PostgreSQL (Metastore & Control de Acceso) ---
POSTGRES_DB=sismowatch_db
POSTGRES_PORT=5432
POSTGRES_HOST=postgres
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres_master_secure_pass_2026!

# Roles de Mínimo Privilegio en PostgreSQL
DB_INGESTION_USER=user_ingestion
DB_INGESTION_PASSWORD=ingestion_least_privilege_2026!
DB_TRANSFORM_USER=user_transform
DB_TRANSFORM_PASSWORD=transform_least_privilege_2026!
DB_PLATFORM_USER=user_platform
DB_PLATFORM_PASSWORD=platform_readonly_privilege_2026!

# --- Backend API (FastAPI) & Autenticación JWT ---
API_PORT=8000
JWT_SECRET_KEY=sismowatch_jwt_ultra_secret_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Credenciales de Usuarios de la Plataforma (Sembradas en BD)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminSismoWatch2026!
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=ViewerSismoWatch2026!

# --- Frontend Web Platform ---
WEB_PORT=3000
VITE_API_BASE_URL=http://localhost:8000
VITE_CARTO_API_KEY=tu_carto_api_key_o_token_aqui

# --- Fuente de Datos Pública (USGS) ---
USGS_REALTIME_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson
USGS_QUERY_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
HTTP_TIMEOUT_SECONDS=10

# --- Inteligencia Artificial & Chatbot ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:2b
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Alertas y Notificaciones en Airflow ---
ALERT_WEBHOOK_URL=
